{
  "appId": "pl.windylist.app",
  "appName": "Windy List",
  "webDir": "www",
  "server": {
    "allowNavigation": [
      "windylist.pl",
      "*.windylist.pl",
      "www.google.com",
      "www.gstatic.com",
      "*.google.com",
      "discord.com"
    ]
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#121218"
  },
  "android": {
    "backgroundColor": "#121218",
    "allowMixedContent": false
  }
}